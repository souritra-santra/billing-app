# ---------------------------------------------------------------------------
# Mobile app (safe to expose — these end up in the Expo bundle)
# ---------------------------------------------------------------------------
# URL of the local/secure Gemini proxy. On an Android emulator use 10.0.2.2
# instead of localhost. On a physical phone use your computer's LAN IP.
EXPO_PUBLIC_AI_PROXY_URL=http://192.168.0.109:8787
# Optional shared secret; must match PROXY_SHARED_SECRET on the proxy.
EXPO_PUBLIC_AI_PROXY_TOKEN=

# Cloud sync + AI Edge Function. Leave blank to keep the app fully local.
# Supabase dashboard -> Project Settings -> API -> Project URL / anon public key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Gemini proxy / Edge Function (server-side only — NEVER add EXPO_PUBLIC_)
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# off | minimal | low | medium | high. Lower = faster/cheaper extraction.
GEMINI_THINKING_LEVEL=low
PROXY_SHARED_SECRET=
PORT=8787
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGIN=*

# Optional Edge Function daily quota per user/shop (default 30).
AI_DAILY_LIMIT=30
