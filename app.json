{
  "expo": {
    "name": "BillingApp",
    "slug": "BillingApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "billingapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0D23",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.soutemp.BillingApp"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BillingApp to access your camera for barcode scanning and AI invoice/label capture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BillingApp to choose invoice or label photos for AI import.",
          "cameraPermission": "Allow BillingApp to photograph invoices and labels for AI import."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0F0D23"
        }
      ],
      "react-native-thermal-printer-driver"
    ]
  }
}
